NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
# Nếu dùng tunnel/domain thật, đặt URL tại đây để QR ưu tiên URL công khai.
PUBLIC_WEB_URL=
WEB_PORT=5173
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=rankrush
JWT_SECRET=rankrush-change-this-secret-in-production
SESSION_TTL_SECONDS=604800
JOIN_CODE_TTL_SECONDS=86400
MAX_PLAYERS_PER_SESSION=300
RESET_CODE_TTL_SECONDS=900
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=300000
