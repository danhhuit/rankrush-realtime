NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
# Nếu dùng tunnel/domain thật, đặt URL tại đây để QR ưu tiên URL công khai.
PUBLIC_WEB_URL=
WEB_PORT=5173
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=rankrush
JWT_SECRET=rankrush-change-this-secret-in-production
SESSION_TTL_SECONDS=604800
JOIN_CODE_TTL_SECONDS=86400
MAX_PLAYERS_PER_SESSION=300
RESET_CODE_TTL_SECONDS=900
EMAIL_CODE_TTL_SECONDS=600
# Chỉ bật khi demo localhost và chưa có SMTP. Production thật phải để false.
EMAIL_DEV_CODE_ENABLED=true
# SMTP dùng được với Gmail App Password, Outlook, Mailgun, Brevo... Port 587 dùng STARTTLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RankRush <no-reply@rankrush.local>
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=300000
