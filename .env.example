NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
# Nếu dùng tunnel/domain thật, đặt URL tại đây để QR ưu tiên URL công khai.
PUBLIC_WEB_URL=
WEB_PORT=5173
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=rankrush
# Để trống để lưu trong thư mục backups/ ở gốc project.
BACKUP_DIR=
BACKUP_MAX_KEYS=50000
JWT_SECRET=rankrush-change-this-secret-in-production
SESSION_TTL_SECONDS=604800
JOIN_CODE_TTL_SECONDS=86400
MAX_PLAYERS_PER_SESSION=300
RESET_CODE_TTL_SECONDS=900
EMAIL_CODE_TTL_SECONDS=600
# Luôn gửi mã qua email; không hiển thị mã thử nghiệm trên giao diện.
EMAIL_DEV_CODE_ENABLED=false
# Gmail App Password dùng cổng 465 với TLS. SMTP_USER/SMTP_PASS là tài khoản gửi;
# email người nhận được lấy động từ form đăng ký hoặc quên mật khẩu.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RankRush <your-email@gmail.com>
AI_PROVIDER=GEMINI
AI_FALLBACK_PROVIDER=OLLAMA
AI_REVIEW_PROVIDER=GEMINI
AI_REVIEW_ENABLED=true
AI_MIN_QUALITY_SCORE=75
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=300000
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=300000
